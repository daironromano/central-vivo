# ============================================================================
# CONFIGURAÇÃO DE AMBIENTE - CENTRALIZADOR DE RELATÓRIOS VIVO (MVC)
# ============================================================================
# No computador pessoal, deixe ENV_MODE=MOCK (lê e formata as bases reais de bruto/)
# No computador da Vivo, mude para ENV_MODE=PROD
ENV_MODE=MOCK

# Chave criptográfica HMAC-SHA256 da sessão e senhas iniciais dos perfis RBAC
APP_SECRET_KEY=troque-por-uma-chave-secreta-aleatoria-na-vivo
ADMIN_DEFAULT_PASSWORD=Vivo@Admin2026
USER_DEFAULT_PASSWORD=Vivo@User2026

# ----------------------------------------------------------------------------
# 1. SISTEMA DOMUS — P1 (API REST 10.215.39.118:8001)
# ----------------------------------------------------------------------------
DOMUS_BASE_URL=http://10.215.39.118:8001
DOMUS_USERNAME=regional_norte
DOMUS_PASSWORD=sua_senha_domus_aqui
DOMUS_API_TOKEN=
DOMUS_MODE=tickets
DOMUS_DETAIL_TYPE=sites_fora
DOMUS_VERIFY_SSL=False

# ----------------------------------------------------------------------------
# 2. ANEL COMUTADO (BI VIA PLAYWRIGHT)
# ----------------------------------------------------------------------------
ANEL_BI_URL=
PLAYWRIGHT_BROWSER_CHANNEL=msedge
PLAYWRIGHT_HEADLESS=False
ANEL_FILENAME_PATTERN=anel

# ----------------------------------------------------------------------------
# 3. CELLDOWNTIME (ERICSSON ENM CLI — https://enmbarb.ran.redestlf.br/#cliapp)
# ----------------------------------------------------------------------------
ENM_HOST=https://enmbarb.ran.redestlf.br
ENM_USERNAME=
ENM_PASSWORD=
ENM_COOKIE=
