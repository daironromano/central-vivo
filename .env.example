# ============================================================================
# CONFIGURAÇÃO DE AMBIENTE - CENTRALIZADOR DE RELATÓRIOS VIVO
# ============================================================================
# No seu computador pessoal (Antigravity), deixe ENV_MODE=MOCK
# No computador da Vivo, copie este arquivo para .env e mude para ENV_MODE=PROD
ENV_MODE=MOCK

# ----------------------------------------------------------------------------
# 1. SISTEMA DOMUS - P1 (API)
# ----------------------------------------------------------------------------
DOMUS_API_URL=https://domus.intranet.vivo.com.br/api/v1/p1
DOMUS_API_TOKEN=seu_token_aqui
DOMUS_VERIFY_SSL=False

# ----------------------------------------------------------------------------
# 2. ANEL COMUTADO (BI)
# ----------------------------------------------------------------------------
ANEL_BI_URL=https://bi.intranet.vivo.com.br/anel-comutado/export
ANEL_BI_COOKIE=
# Caso baixe no navegador, o sistema também pode puxar automático da pasta Downloads:
ANEL_FILENAME_PATTERN=anel_comutado

# ----------------------------------------------------------------------------
# 3. BACKLOG DIÁRIO (MAESTRO)
# ----------------------------------------------------------------------------
MAESTRO_URL=https://maestro.intranet.vivo.com.br/backlog/export
MAESTRO_COOKIE=
MAESTRO_FILENAME_PATTERN=backlog
